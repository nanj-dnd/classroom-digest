{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.js": {
      "includeFiles": "pages/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/home"
    },
    {
      "source": "/signin",
      "destination": "/api/signin"
    },
    {
      "source": "/callback",
      "destination": "/api/callback"
    },
    {
      "source": "/privacy",
      "destination": "/api/privacy"
    },
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/oauth/authorize",
      "destination": "/api/oauth-authorize"
    },
    {
      "source": "/oauth/token",
      "destination": "/api/oauth-token"
    },
    {
      "source": "/oauth/register",
      "destination": "/api/oauth-register"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/oauth-metadata?kind=resource"
    },
    {
      "source": "/.well-known/oauth-protected-resource/mcp",
      "destination": "/api/oauth-metadata?kind=resource"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/api/oauth-metadata?kind=as"
    },
    {
      "source": "/.well-known/oauth-authorization-server/mcp",
      "destination": "/api/oauth-metadata?kind=as"
    },
    {
      "source": "/.well-known/openid-configuration",
      "destination": "/api/oauth-metadata?kind=as"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        }
      ]
    }
  ],
  "outputDirectory": "public"
}
