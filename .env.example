# Where the morning digest is sent
DIGEST_TO=you@example.com

# Resend (https://resend.com) — used only to send you the digest
RESEND_API_KEY=
DIGEST_FROM=college@yourdomain.com

# Feature flags — turn any off if a scope gets blocked or you don't want it
SYNC_DRIVE=true
SYNC_CALENDAR=true
CALENDAR_NAME=College

# How far ahead the digest looks
HORIZON_DAYS=14

EXCLUDE_COURSES=Spring 2026
